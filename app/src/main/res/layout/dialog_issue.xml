<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="مشتری"
            android:textAlignment="viewStart"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12.5sp" />

        <Spinner
            android:id="@+id/sp_issue_customer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/et_issue_device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="شناسه‌ی دستگاه (مثل K7M2A-9QX4T)"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="14"
            android:textAlignment="viewStart" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="نوع لایسنس"
            android:textAlignment="viewStart"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12.5sp" />

        <Spinner
            android:id="@+id/sp_issue_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/et_issue_discount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="درصد تخفیف"
            android:inputType="numberDecimal"
            android:textAlignment="viewStart" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="ویزیتور معرف"
            android:textAlignment="viewStart"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12.5sp" />

        <Spinner
            android:id="@+id/sp_issue_visitor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/et_issue_commission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="درصد پورسانت ویزیتور"
            android:inputType="numberDecimal"
            android:textAlignment="viewStart" />

        <EditText
            android:id="@+id/et_issue_paid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="مبلغ دریافتی همین الان (تومان؛ اقساط = کمتر از کل)"
            android:inputType="number"
            android:textAlignment="viewStart" />

        <EditText
            android:id="@+id/et_issue_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="یادداشت"
            android:inputType="text"
            android:textAlignment="viewStart" />

        <TextView
            android:id="@+id/tv_issue_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:textAlignment="viewStart"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
