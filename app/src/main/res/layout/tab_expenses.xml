<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl">

    <ListView
            android:id="@+id/list_expenses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:drawSelectorOnTop="true"
            android:listSelector="@drawable/sel_card"
            android:paddingTop="4dp"
            android:paddingBottom="88dp"
            android:scrollbars="none" />

    <TextView
        android:id="@+id/empty_expenses"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="هنوز هزینه‌ای ثبت نشده است"
        android:textColor="?android:attr/textColorSecondary" />

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_add_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="ثبت هزینه"
            android:text="ثبت هزینه"
            app:icon="@drawable/ic_add" />
</FrameLayout>
