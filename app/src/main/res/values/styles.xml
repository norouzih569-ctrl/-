<resources>
    <!-- گوشه‌های گرد برای همه‌ی اجزا (کارت، دکمه، دیالوگ) -->
    <style name="ShapeAppearance.Barber.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.Barber.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.Barber.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- کارت پایه: سطح سفید/تیره‌ی تم، لبه‌ی خیلی ظریف و سایه‌ی ملایم -->
    <style name="Widget.Barber.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">?attr/barberSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">?attr/barberCardStroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Barber.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">11dp</item>
        <item name="android:paddingBottom">11dp</item>
        <item name="android:textColorHint">?android:attr/textColorSecondary</item>
    </style>

    <style name="Widget.Barber.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="elevation">12dp</item>
    </style>

    <style name="ThemeOverlay.Barber.Toolbar" parent="ThemeOverlay.AppCompat">
        <item name="colorControlNormal">?attr/barberOnToolbar</item>
        <item name="colorControlActivated">?attr/barberOnToolbar</item>
    </style>

    <!-- فونت وزیرمتن برای همه‌ی متن‌ها -->
    <style name="TextAppearance.Barber.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.Barber.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.Barber.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.Barber.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.Barber.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
    <style name="TextAppearance.Barber.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TextAppearance.Barber.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">@font/vazirmatn</item>
        <item name="fontFamily">@font/vazirmatn</item>
    </style>
</resources>
